<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhantomVault_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#0E1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: BRANDING + QUICK EMERGENCY ACTIONS -->
        <Border Grid.Row="0" Background="#161922" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- BRAND LOGO & TAGLINE -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrandPurpleBrush}" CornerRadius="8" Width="36" Height="36">
                        <FontIcon Glyph="&#xE72E;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="PHANTOMVAULT" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Trust Nothing. Reveal Nothing." FontSize="11" Foreground="{StaticResource BrandCyanBrush}" FontStyle="Italic" />
                    </StackPanel>
                </StackPanel>

                <!-- GLOBAL STATUS BADGE & EMERGENCY LOCK -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- VAULT STATUS PILL -->
                    <Border x:Name="VaultStatusPill" Background="#374151" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="VaultStatusText" Text="LOCKED" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" />
                    </Border>

                    <!-- QUICK EMERGENCY LOCK BUTTON -->
                    <Button Content="EMERGENCY LOCK" Style="{StaticResource DangerButtonStyle}" Click="EmergencyLockAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- NOTIFICATIONS & DEAD-MAN'S SWITCH WARNING BANNER -->
        <StackPanel Grid.Row="1">
            <!-- DEAD-MAN'S SWITCH COUNTDOWN BANNER -->
            <Border x:Name="DeadMansBanner" Background="{StaticResource BrandDangerBrush}" Padding="16,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" Foreground="White" FontSize="18" />
                        <TextBlock x:Name="DeadMansCountdownText" Text="INACTIVITY WARNING: Vaults locking in 30 seconds!" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Dismiss / Still Active" Background="White" Foreground="Black" FontWeight="Bold" Click="DismissDeadMans_Click" />
                </Grid>
            </Border>

            <!-- APP INFOBAR -->
            <InfoBar x:Name="AppInfoBar" IsOpen="False" IsClosable="True" Margin="16,8,16,0" />
        </StackPanel>

        <!-- MAIN NAVIGATION VIEW -->
        <NavigationView x:Name="NavView" Grid.Row="2" 
                        PaneDisplayMode="Left" 
                        IsBackButtonVisible="Collapsed" 
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Vault Files" Tag="Vault" Icon="Folder" />
                <NavigationViewItem Content="Steganography" Tag="Stego" Icon="Pictures" />
                <NavigationViewItem Content="Backup &amp; Recovery" Tag="Backup" Icon="Save" />
                <NavigationViewItem Content="Security Center" Tag="Security" Icon="ProtectedDocument" />
                <NavigationViewItem Content="Audit Log" Tag="Logs" Icon="List" />
                <NavigationViewItem Content="Settings &amp; Policies" Tag="Settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- BUSY PROGRESS OVERLAY -->
        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#AA0E1117" Visibility="Collapsed">
            <Border Background="#1E222D" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="48" Height="48" Foreground="{StaticResource BrandPurpleBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="BusyText" Text="Performing cryptographic operation..." FontWeight="SemiBold" TextAlignment="Center" />
                    <ProgressBar x:Name="BusyProgressBar" Minimum="0" Maximum="1" Value="0" HorizontalAlignment="Stretch" Foreground="{StaticResource BrandPurpleBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
