<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhantomVault_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: BRANDING, STATUS BADGE & QUICK EMERGENCY LOCK -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- BRAND LOGO & TAGLINE -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{StaticResource ElevatedSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Width="36" Height="36">
                        <FontIcon Glyph="&#xE72E;" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="PHANTOMVAULT" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Trust Nothing. Reveal Nothing." FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- ACTIVE VAULT CONTEXT -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Active Vault:" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="HeaderActiveVaultText" Text="None Selected" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>

                <!-- GLOBAL STATUS BADGE & EMERGENCY LOCK -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- VAULT STATUS PILL -->
                    <Border x:Name="VaultStatusPill" Background="{StaticResource ElevatedSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                        <TextBlock x:Name="VaultStatusText" Text="LOCKED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    </Border>

                    <!-- QUICK EMERGENCY LOCK BUTTON -->
                    <Button Content="EMERGENCY LOCK" Style="{StaticResource DestructiveButtonStyle}" Click="EmergencyLockAll_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- NOTIFICATIONS & DEAD-MAN'S SWITCH WARNING BANNER -->
        <StackPanel Grid.Row="1">
            <!-- DEAD-MAN'S SWITCH COUNTDOWN BANNER -->
            <Border x:Name="DeadMansBanner" Background="{StaticResource ErrorBrush}" Padding="16,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" Foreground="#0B0D12" FontSize="18" />
                        <TextBlock x:Name="DeadMansCountdownText" Text="INACTIVITY WARNING: All vaults locking in 30 seconds!" FontWeight="Bold" Foreground="#0B0D12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Dismiss / Still Active" Background="#0B0D12" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Bold" Click="DismissDeadMans_Click" />
                </Grid>
            </Border>

            <!-- APP INFOBAR -->
            <InfoBar x:Name="AppInfoBar" IsOpen="False" IsClosable="True" Margin="20,10,20,0" />
        </StackPanel>

        <!-- MAIN NAVIGATION VIEW WITH SHELL LAYOUT -->
        <NavigationView x:Name="NavView" Grid.Row="2" 
                        PaneDisplayMode="Left" 
                        IsBackButtonVisible="Collapsed" 
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" />
                <NavigationViewItem Content="My Vaults" Tag="Vaults" Icon="Folder" />
                <NavigationViewItem Content="Vault Workspace" Tag="Vault" Icon="OpenFile" />
                <NavigationViewItem Content="Steganography" Tag="Stego" Icon="Pictures" />
                <NavigationViewItem Content="Recovery &amp; Backups" Tag="Backup" Icon="Save" />
                <NavigationViewItem Content="Security Center" Tag="Security" Icon="ProtectedDocument" />
                <NavigationViewItem Content="Emergency Access" Tag="Emergency" Icon="Shield" />
                <NavigationViewItem Content="Activity Log" Tag="Logs" Icon="List" />
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <!-- SIDEBAR FOOTER: VERSION & OFFLINE INDICATOR -->
            <NavigationView.PaneFooter>
                <Border Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PHANTOMVAULT v1.0.0 LTS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Local-Only • Offline" FontSize="11" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" Background="{StaticResource PrimaryBackgroundBrush}" />
        </NavigationView>

        <!-- BUSY PROGRESS OVERLAY -->
        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#D80B0D12" Visibility="Collapsed">
            <Border Style="{StaticResource SecurityCardStyle}" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="44" Height="44" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="BusyText" Text="Performing cryptographic operation..." FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                    <ProgressBar x:Name="BusyProgressBar" Minimum="0" Maximum="1" Value="0" HorizontalAlignment="Stretch" Foreground="{StaticResource PrimaryAccentBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
