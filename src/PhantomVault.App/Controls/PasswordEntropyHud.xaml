<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhantomVault_App.Controls.PasswordEntropyHud"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <!-- 4-SEGMENT PROGRESS BARS -->
        <Grid ColumnSpacing="4" Height="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Bar1" Grid.Column="0" Background="{StaticResource BorderBrush}" CornerRadius="2" />
            <Border x:Name="Bar2" Grid.Column="1" Background="{StaticResource BorderBrush}" CornerRadius="2" />
            <Border x:Name="Bar3" Grid.Column="2" Background="{StaticResource BorderBrush}" CornerRadius="2" />
            <Border x:Name="Bar4" Grid.Column="3" Background="{StaticResource BorderBrush}" CornerRadius="2" />
        </Grid>

        <!-- STRENGTH HEADER & METRICS -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Strength Label & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon x:Name="StrengthIcon" Glyph="&#xE72E;" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StrengthLabelText" Text="PASSWORD STRENGTH: NOT EVALUATED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Entropy & Crack Time Stats -->
            <TextBlock x:Name="MetricsText" Grid.Column="1" Text="Entropy: 0 bits • Crack Time: instant" FontSize="11" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
        </Grid>

        <!-- 4 REQUIREMENT BADGES -->
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Badge 1: Length -->
            <Border x:Name="BadgeLength" Grid.Column="0" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="BadgeLengthIcon" Text="✖" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="BadgeLengthText" Text="12+ Chars" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Badge 2: Mixed Case -->
            <Border x:Name="BadgeCase" Grid.Column="1" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="BadgeCaseIcon" Text="✖" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="BadgeCaseText" Text="A-Z &amp; a-z" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Badge 3: Numbers & Symbols -->
            <Border x:Name="BadgeSymbols" Grid.Column="2" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="BadgeSymbolsIcon" Text="✖" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="BadgeSymbolsText" Text="0-9 &amp; Symbols" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Badge 4: Entropy Level -->
            <Border x:Name="BadgeEntropy" Grid.Column="3" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="BadgeEntropyIcon" Text="✖" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="BadgeEntropyText" Text="60+ Bits" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
