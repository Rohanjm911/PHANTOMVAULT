<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhantomVault_App.Views.EmergencyAccessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- HEADER -->
            <StackPanel Spacing="4">
                <TextBlock Text="Emergency Policies &amp; Lock Safeguards" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Safety-focused session policies, automated lock timers, and configurable dead-man's countdown safeguards." 
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
            </StackPanel>

            <!-- STATUS & TEST MODE BANNER -->
            <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="CURRENT POLICY STATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="PolicyStatusDescriptionText" Text="Standard Protection Active" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Vaults lock automatically upon prolonged inactivity or workstation lock (Win + L)." FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Test Countdown (10s)" Style="{StaticResource SecondaryButtonStyle}" Click="TestCountdownButton_Click" />
                        <Button Content="Cancel Pending Action" Style="{StaticResource DestructiveButtonStyle}" Click="CancelPendingButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SECTION 1: INACTIVITY AUTO-LOCK (ORDINARY) -->
            <Border Style="{StaticResource SecurityCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" />
                        <TextBlock Text="AUTOMATIC INACTIVITY LOCK" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <TextBlock Text="Locks all active vaults and purges cryptographic keys from volatile memory if no user activity is detected for the configured interval." 
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />

                    <ToggleSwitch x:Name="AutoLockToggle" Header="Enable Automatic Inactivity Locking" IsOn="True" Toggled="PolicySettingChanged" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Inactivity Threshold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="InactivityTimeoutLabel" Text="15 Minutes" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="InactivitySlider" Minimum="1" Maximum="120" Value="15" StepFrequency="1" ValueChanged="InactivitySlider_ValueChanged" />
                    </StackPanel>

                    <ToggleSwitch x:Name="SessionLockToggle" Header="Purge Keys Immediately on Windows Workstation Lock (Win + L)" IsOn="True" Toggled="PolicySettingChanged" />
                </StackPanel>
            </Border>

            <!-- SECTION 2: DEAD-MAN'S SWITCH SAFEGUARD -->
            <Border Style="{StaticResource SecurityCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="DEAD-MAN'S SWITCH SAFEGUARD" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <TextBlock Text="Disabled by default. When enabled, extended inactivity initiates a conspicuous audio and visual countdown banner before locking all vaults unless dismissed." 
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />

                    <ToggleSwitch x:Name="DeadMansToggle" Header="Enable Dead-Man's Switch Safeguard" IsOn="False" Toggled="PolicySettingChanged" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Extended Inactivity Threshold" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="DeadMansTimeoutLabel" Text="60 Minutes" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="DeadMansSlider" Minimum="5" Maximum="240" Value="60" StepFrequency="5" ValueChanged="DeadMansSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Warning Countdown Period" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="WarningCountdownLabel" Text="30 Seconds" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="WarningCountdownSlider" Minimum="10" Maximum="120" Value="30" StepFrequency="5" ValueChanged="WarningCountdownSlider_ValueChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- APPLY POLICY BUTTON -->
            <Button Content="Save &amp; Apply Emergency Policies" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Padding="24,10" Click="SavePolicyButton_Click" />

            <!-- POLICY DISCLOSURE -->
            <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Transparent Security Philosophy" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="PHANTOMVAULT strictly prioritizes user safety and non-destructive policies. Inactivity never triggers silent file deletion, data destruction, or remote transmissions. All emergency actions are strictly limited to zeroizing master keys in volatile memory and closing open file handles." 
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
