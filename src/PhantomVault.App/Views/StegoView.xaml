<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhantomVault_App.Views.StegoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:PhantomVault_App.Controls"
    mc:Ignorable="d">

    <Grid Padding="28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Steganography Studio" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock Text="Conceal authenticated encrypted payloads inside PNG images and 16-bit PCM WAV audio carriers using LSB encoding." 
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
        </StackPanel>

        <!-- TABS: HIDE DATA (GUIDED) / EXTRACT DATA -->
        <TabView x:Name="StegoTabView" Grid.Row="1" CanReorderTabs="False">
            <!-- TAB 1: GUIDED CONCEALMENT WORKFLOW -->
            <TabViewItem Header="Conceal Data (Hide)" IsClosable="False">
                <ScrollViewer Padding="0,16,0,0">
                    <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Left">

                        <Border x:Name="CarrierCardBorder" Style="{StaticResource SecurityCardStyle}" 
                                AllowDrop="True" DragOver="CarrierDrop_DragOver" DragLeave="CarrierDrop_DragLeave" Drop="CarrierDrop_Drop">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{StaticResource PrimaryAccentBrush}" CornerRadius="10" Width="20" Height="20">
                                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#0B0D12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="SELECT CARRIER MEDIA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="💡 Drag &amp; drop PNG or WAV here" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CarrierPathBox" PlaceholderText="Select or drop a .png image or .wav audio carrier..." IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="Browse Carrier..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowseCarrierButton_Click" />
                                </Grid>

                                <Grid x:Name="CapacityReportGrid" Visibility="Collapsed" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16" CornerRadius="8" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail or Audio Glyph -->
                                    <Border Grid.Column="0" Background="{StaticResource ElevatedBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Width="100" Height="80" VerticalAlignment="Center">
                                        <Grid>
                                            <Image x:Name="CarrierThumbnailImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <FontIcon x:Name="CarrierAudioIcon" Glyph="&#xE8D6;" FontSize="32" Foreground="{StaticResource SecondaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="CARRIER TYPE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock x:Name="CarrierTypeText" Text="PNG Image" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="CarrierFormatText" Text="RGBA 32-bit" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="SPECIFICATIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock x:Name="CarrierDimsText" Text="1920 x 1080" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="CarrierFileSizeText" Text="2.4 MB on disk" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="USABLE CAPACITY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock x:Name="CarrierCapacityText" Text="777.6 KB" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                        <TextBlock Text="LSB 1 bit/ch" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>

                                <!-- AUDIO CARRIER PLAYBACK & PARITY AUDITOR (REVEALED FOR WAV) -->
                                <Border x:Name="AudioCarrierAuditorBorder" Visibility="Collapsed" Background="{StaticResource ElevatedBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="{StaticResource SecondaryAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="AUDIO CARRIER ACOUSTIC AUDITOR &amp; PLAYER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryAccentBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="PlayCarrierAudioButton" Content="▶ Play Carrier Audio" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="PlayCarrierAudioButton_Click" />
                                                <Button x:Name="StopCarrierAudioButton" Content="⏹ Stop" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Click="StopCarrierAudioButton_Click" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- PARITY & ACOUSTIC TRANSPARENCY HUD -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="8,6" CornerRadius="4">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="SAMPLE RATE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock x:Name="AudioSampleRateText" Text="44,100 Hz" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SecondaryBackgroundBrush}" Padding="8,6" CornerRadius="4">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="CHANNELS / DEPTH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock x:Name="AudioChannelsText" Text="Mono (16-bit PCM)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource SecondaryBackgroundBrush}" Padding="8,6" CornerRadius="4">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="PARITY ENTROPY" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="0.9998 bits/s" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{StaticResource SecondaryBackgroundBrush}" Padding="8,6" CornerRadius="4">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="ACOUSTIC DISTORTION" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="0.0000% (Zero Leak)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- STEP 2: SELECT PAYLOAD (DRAG & DROP READY) -->
                        <Border x:Name="PayloadCardBorder" Style="{StaticResource SecurityCardStyle}" 
                                AllowDrop="True" DragOver="PayloadDrop_DragOver" DragLeave="PayloadDrop_DragLeave" Drop="PayloadDrop_Drop">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{StaticResource PrimaryAccentBrush}" CornerRadius="10" Width="20" Height="20">
                                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#0B0D12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="SELECT SECRET PAYLOAD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="💡 Drag &amp; drop any secret file here" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Any file type can be concealed. The payload is encrypted with AES-256-GCM before embedding into the carrier." 
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PayloadPathBox" PlaceholderText="Select or drop file to encrypt and conceal..." IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="Browse Payload..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowsePayloadButton_Click" />
                                </Grid>

                                <Border x:Name="PayloadDetailsBorder" Background="{StaticResource SecondaryBackgroundBrush}" Padding="12,8" CornerRadius="6" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PayloadDetailsText" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- STEP 3: CONFIGURE PROTECTION WITH INTERACTIVE ENTROPY HUD -->
                        <Border Style="{StaticResource SecurityCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{StaticResource PrimaryAccentBrush}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#0B0D12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="CONFIGURE ENCRYPTION PASSWORD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <PasswordBox x:Name="StegoPasswordBox" PlaceholderText="Enter master password to encrypt payload with AES-256-GCM" PasswordChanged="StegoPasswordBox_PasswordChanged" />
                                
                                <!-- REUSABLE CYBER HUD ENTROPY METER -->
                                <controls:PasswordEntropyHud x:Name="StegoEntropyHud" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- STEP 4: CAPACITY CHECK -->
                        <Border Style="{StaticResource SecurityCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{StaticResource PrimaryAccentBrush}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="4" FontSize="11" FontWeight="Bold" Foreground="#0B0D12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="CAPACITY &amp; INTEGRITY VALIDATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock x:Name="CapacityCheckMessageText" Text="Select carrier and secret payload to check capacity." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- STEP 5 & 6: OUTPUT LOCATION & EMBED ACTION -->
                        <Border Style="{StaticResource SecurityCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{StaticResource PrimaryAccentBrush}" CornerRadius="10" Width="20" Height="20">
                                        <TextBlock Text="5" FontSize="11" FontWeight="Bold" Foreground="#0B0D12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="OUTPUT DESTINATION &amp; CONCEALMENT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Your original carrier will never be overwritten. A new concealed file will be generated." 
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputPathBox" PlaceholderText="Output file path (default: [original]_concealed.png)" />
                                    <Button Grid.Column="1" Content="Browse Save As..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowseSaveAs_Click" />
                                </Grid>

                                <Button x:Name="EmbedButton" Content="Embed and Save Concealed Carrier" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Padding="24,10" Click="EmbedButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- STEP 6: VISUAL COMPARISON & INSPECTOR RESULTS -->
                        <Border x:Name="StegoResultCard" Visibility="Collapsed" Style="{StaticResource SecurityCardStyle}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="CONCEALMENT COMPLETE &amp; VERIFIED" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="0.00% Perceptual Difference" FontSize="11" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{StaticResource PrimaryAccentBrush}" />
                                    </Border>
                                </Grid>

                                <!-- SIDE-BY-SIDE VISUAL COMPARISON -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Original Carrier Box -->
                                    <Border Grid.Column="0" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="ORIGINAL CARRIER MEDIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <Border Background="{StaticResource PrimaryBackgroundBrush}" CornerRadius="6" Height="140">
                                                <Grid>
                                                    <Image x:Name="CompareOriginalImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <FontIcon x:Name="CompareOriginalAudioIcon" Glyph="&#xE8D6;" FontSize="40" Foreground="{StaticResource SecondaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="CompareOriginalSpecsText" Text="1920x1080 • Clean Carrier" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Concealed Stego Box -->
                                    <Border Grid.Column="1" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="CONCEALED STEGO CARRIER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                                            <Border Background="{StaticResource PrimaryBackgroundBrush}" CornerRadius="6" Height="140">
                                                <Grid>
                                                    <Image x:Name="CompareStegoImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <FontIcon x:Name="CompareStegoAudioIcon" Glyph="&#xE8D6;" FontSize="40" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="CompareStegoSpecsText" Text="1920x1080 • Encrypted Payload Sealed" FontSize="11" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- QUICK ACTIONS -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="PlayStegoAudioButton" Content="▶ Audition Stego Audio" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" Click="PlayStegoAudioButton_Click" />
                                    <Button Content="Open Concealed Media" Style="{StaticResource PrimaryButtonStyle}" Click="OpenConcealedFile_Click" />
                                    <Button Content="Show in Folder" Style="{StaticResource SecondaryButtonStyle}" Click="ShowInFolder_Click" />
                                    <Button Content="Test Extraction in Studio" Style="{StaticResource SecondaryButtonStyle}" Click="SwitchToExtract_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TECHNICAL DISCLAIMER -->
                        <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Security &amp; Forensic Disclosure" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="LSB steganography embeds encrypted bytes into the least-significant bits of carrier samples. While visually and audibly undetectable to humans, statistical steganalysis or deep forensic analysis may detect anomalies. Do not claim absolute deniability." 
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- TAB 2: EXTRACTION WORKFLOW -->
            <TabViewItem Header="Extract Hidden Data" IsClosable="False">
                <ScrollViewer Padding="0,16,0,0">
                    <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
                        <Border Style="{StaticResource SecurityCardStyle}"
                                AllowDrop="True" DragOver="CarrierDrop_DragOver" DragLeave="CarrierDrop_DragLeave" Drop="ExtractCarrierDrop_Drop">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="1. SELECT CONCEALED CARRIER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                                    <TextBlock Grid.Column="1" Text="💡 Drag &amp; drop concealed file here" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExtractCarrierPathBox" PlaceholderText="Select or drop image or audio containing concealed payload..." IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="Browse Carrier..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowseExtractCarrier_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SecurityCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="2. DECRYPTION PASSWORD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                                <PasswordBox x:Name="ExtractPasswordBox" PlaceholderText="Enter password used during concealment" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SecurityCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="3. DESTINATION DIRECTORY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExtractOutDirBox" PlaceholderText="Select folder to save extracted file..." IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="Browse Folder..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowseExtractOutDir_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="Extract &amp; Verify Hidden Payload" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Padding="24,10" Click="ExtractButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
