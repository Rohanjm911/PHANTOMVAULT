<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhantomVault_App.Views.VaultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PhantomVault.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- TACTICAL SHAKE ANIMATION ON FAILED MASTER PASSWORD OR AUTH ERROR -->
        <Storyboard x:Name="ShakeStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LockedCardTranslation" Storyboard.TargetProperty="X">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.04" Value="-14" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="14" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="-10" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="10" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="-6" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="6" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="-2" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: BREADCRUMBS & VAULT SELECTOR -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Spacing="4">
                <!-- CONTEXTUAL BREADCRUMBS -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="PHANTOMVAULT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="/" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="BreadcrumbVaultNameText" Text="No Vault Selected" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Text="/" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Encrypted Workspace" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <TextBlock Text="Vault Workspace" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Authenticated, chunked local file storage. Ciphertext and metadata are cryptographically sealed at rest." 
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
            </StackPanel>

            <!-- VAULT SELECTOR & ACTIONS -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ComboBox x:Name="VaultsComboBox" Width="220" 
                          DisplayMemberPath="Name"
                          SelectionChanged="VaultsComboBox_SelectionChanged" />
                
                <Button Content="New Vault" Style="{StaticResource PrimaryButtonStyle}" Click="NewVaultButton_Click" />
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <!-- LOCKED STATE -->
            <Grid x:Name="LockedPanel" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <Border x:Name="LockedCardBorder" Style="{StaticResource SecurityCardStyle}" Padding="36" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LockedCardTranslation" X="0" Y="0" />
                    </Border.RenderTransform>
                    <StackPanel Spacing="18" HorizontalAlignment="Stretch">
                        <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="32" Width="64" Height="64" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="28" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        
                        <TextBlock Text="Vault Locked" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Cryptographic keys are currently purged from memory. Enter your master password to derive the key via Argon2id and unseal storage." 
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" />

                        <PasswordBox x:Name="UnlockPasswordBox" PlaceholderText="Enter Master Password" KeyDown="UnlockPasswordBox_KeyDown" HorizontalAlignment="Stretch" />
                        
                        <Button Content="Unlock Vault" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="UnlockButton_Click" />

                        <!-- WINDOWS HELLO BIOMETRIC UNLOCK BUTTON -->
                        <Button x:Name="WindowsHelloUnlockButton" Content="Unlock with Windows Hello (PIN/Biometric)" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="WindowsHelloUnlockButton_Click" />

                        <TextBlock x:Name="UnlockErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- UNLOCKED STATE (STAGGERED ENTRANCE ANIMATION) -->
            <Grid x:Name="UnlockedPanel" Visibility="Collapsed">
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- STATS STRIP -->
                <Grid Grid.Row="0" ColumnSpacing="16" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SecurityCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="STORED FILES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="FileCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SecurityCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ENCRYPTED ON DISK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="CiphertextSizeText" Text="0 KB" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SecurityCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CIPHER PRIMITIVE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="AES-256-GCM" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource SecurityCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="DERIVATION KDF" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="Argon2id (64MB)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SecondaryAccentBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- TOOLBAR WITH VIEW TOGGLES & SHREDDER -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- IMPORT SPLIT BUTTON -->
                        <DropDownButton Content="Import Files..." Style="{StaticResource PrimaryButtonStyle}">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Import Files (Keep Plaintext Original)" Click="ImportStandard_Click" />
                                    <MenuFlyoutItem Text="Import &amp; Shred Original (DoD 5220.22-M)" Click="ImportAndShred_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button Content="Shred External File" Style="{StaticResource DestructiveButtonStyle}" Click="StandaloneShredderButton_Click" />
                        <Button Content="Plausible Deniability..." Style="{StaticResource SecondaryButtonStyle}" Click="SetupDuressButton_Click" ToolTipService.ToolTip="Configure secondary duress password for decoy vault unsealing" />
                        <Button Content="Lock Vault" Style="{StaticResource SecondaryButtonStyle}" Click="LockButton_Click" />
                    </StackPanel>

                    <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search stored files by name..." Margin="12,0,12,0" TextChanged="SearchBox_TextChanged" />

                    <!-- VIEW MODE TOGGLE & SORTING -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- SORT COMBOBOX -->
                        <ComboBox x:Name="SortComboBox" Width="145" SelectionChanged="SortComboBox_SelectionChanged">
                            <ComboBoxItem Content="Newest First" Tag="DateDesc" IsSelected="True" />
                            <ComboBoxItem Content="Oldest First" Tag="DateAsc" />
                            <ComboBoxItem Content="Name (A-Z)" Tag="NameAsc" />
                            <ComboBoxItem Content="Name (Z-A)" Tag="NameDesc" />
                            <ComboBoxItem Content="Size (Largest)" Tag="SizeDesc" />
                            <ComboBoxItem Content="Size (Smallest)" Tag="SizeAsc" />
                        </ComboBox>

                        <!-- LIST / GRID TOGGLE BUTTONS -->
                        <Button x:Name="ViewListButton" Style="{StaticResource PrimaryButtonStyle}" Padding="8,6" Click="ViewListButton_Click" ToolTipService.ToolTip="Table View">
                            <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                        </Button>
                        <Button x:Name="ViewGridButton" Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" Click="ViewGridButton_Click" ToolTipService.ToolTip="Card Grid View">
                            <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                        </Button>

                        <Button Content="Verify All" Style="{StaticResource SecondaryButtonStyle}" Click="VerifyAllButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- FILES CONTAINER WITH DRAG-AND-DROP -->
                <Grid Grid.Row="2" x:Name="FilesContainerGrid" AllowDrop="True" 
                      DragOver="FilesArea_DragOver" DragLeave="FilesArea_DragLeave" Drop="FilesArea_Drop">
                    
                    <!-- 1. TABLE LIST VIEW -->
                    <Border x:Name="FilesListBorder" Style="{StaticResource SecurityCardStyle}" Padding="0" Visibility="Visible">
                        <ListView x:Name="FilesListView" SelectionMode="Single">
                            <ListView.Header>
                                <Grid Padding="16,10" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="Size" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="SHA-256 Digest" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="3" Text="Added Date" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="4" Text="Actions" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </ListView.Header>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:VaultEntry">
                                    <Grid Padding="16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{x:Bind PlaintextSizeBytes}" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Sha256Hash}" FontSize="11" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind CreatedAtUtc}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />

                                        <!-- ACTION BUTTONS: PREVIEW, EXPORT, RENAME, DELETE -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Preview" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="PreviewEntryButton_Click" />
                                            <Button Content="Export" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="ExportEntryButton_Click" />
                                            <Button Content="Rename" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Click="RenameEntryButton_Click" />
                                            <Button Content="Delete" Style="{StaticResource DestructiveButtonStyle}" Padding="8,4" FontSize="11" Click="DeleteEntryButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- 2. CARD GRID VIEW -->
                    <Border x:Name="FilesGridBorder" Style="{StaticResource SecurityCardStyle}" Padding="16" Visibility="Collapsed">
                        <GridView x:Name="FilesGridView" SelectionMode="Single">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:VaultEntry">
                                    <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Width="240" Height="170" Margin="6">
                                        <Grid RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Header: Icon & Size Badge -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource PrimaryBackgroundBrush}" CornerRadius="6" Width="32" Height="32" HorizontalAlignment="Left">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Grid.Column="1" Background="{StaticResource ElevatedBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind PlaintextSizeBytes}" FontSize="10" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{StaticResource SecondaryTextBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Body: Name & SHA-256 -->
                                            <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                <TextBlock Text="{x:Bind Sha256Hash}" FontSize="10" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Footer Actions -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                <Button Content="Preview" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="10" Click="PreviewEntryButton_Click" />
                                                <Button Content="Export" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="10" Click="ExportEntryButton_Click" />
                                                <Button Content="Rename" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="10" Click="RenameEntryButton_Click" />
                                                <Button Content="Delete" Style="{StaticResource DestructiveButtonStyle}" Padding="8,4" FontSize="10" Click="DeleteEntryButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Border>

                    <!-- EMPTY VAULT STATE (WITH DRAG & DROP HINT) -->
                    <Border x:Name="EmptyVaultWorkspaceBorder" Background="{StaticResource ElevatedBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Visibility="Collapsed">
                        <StackPanel Spacing="14" HorizontalAlignment="Center">
                            <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="28" Width="56" Height="56" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE898;" FontSize="26" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="This vault is empty." FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Drag and drop files directly here to encrypt, or click below to browse from your device. All files are partitioned into 64 KiB independently authenticated AES-256-GCM chunks." 
                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" />
                            <Button Content="Browse &amp; Import Files" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Padding="22,10" Click="ImportButton_Click" />
                        </StackPanel>
                    </Border>

                    <!-- DRAG OVERLAY -->
                    <Border x:Name="DropTargetOverlay" Visibility="Collapsed" Background="#E611151D" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="2" CornerRadius="8" Padding="32" Canvas.ZIndex="100">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                            <Border Background="{StaticResource ElevatedBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="32" Width="64" Height="64" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE898;" FontSize="28" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Release to Encrypt &amp; Store" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Files will be partitioned into 64 KiB independently authenticated AES-256-GCM chunks." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                            <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" HorizontalAlignment="Center">
                                <TextBlock Text="🔒 Zero Plaintext Leaks • Memory-Zeroized Ingestion" FontSize="11" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{StaticResource PrimaryAccentBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
