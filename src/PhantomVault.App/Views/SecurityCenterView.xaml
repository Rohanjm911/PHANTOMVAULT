<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhantomVault_App.Views.SecurityCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Left">

            <!-- HEADER -->
            <StackPanel Spacing="4">
                <TextBlock Text="Security &amp; Cryptography Center" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Comprehensive audit of local cryptographic guarantees, key hierarchy, and emergency session policies." 
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
            </StackPanel>

            <!-- POSTURE BANNER -->
            <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource ElevatedSurfaceBrush}" CornerRadius="24" Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE72E;" FontSize="24" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="CRYPTOGRAPHIC PROTECTION STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="MAXIMUM SECURITY — LOCAL ENCLAVE ACTIVE" FontSize="17" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="AES-256-GCM authenticated cipher with Argon2id memory-hard key derivation." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{StaticResource PrimaryAccentBrush}" CornerRadius="4" Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Text="PROTECTED" FontWeight="Bold" FontSize="11" Foreground="#0B0D12" />
                    </Border>
                </Grid>
            </Border>

            <!-- 4-SECTION STRUCTURED AUDIT GRID -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SECTION 1: ENCRYPTION -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SecurityCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" />
                            <TextBlock Text="ENCRYPTION PRIMITIVES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Symmetric Algorithm" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="AES-256-GCM (NIST SP 800-38D)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Key Derivation (KDF)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="Argon2id (RFC 9106, 64 MB, 4 Lanes)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Chunk Framing" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="64 KiB Chunks with AAD UUID Binding" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="RNG Entropy Source" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="System.Security.Cryptography.CSPRNG" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Vault Header Version" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="Format v1 (PVLT)" FontSize="12" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: ACCESS & MEMORY -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SecurityCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D7;" FontSize="16" Foreground="{StaticResource SecondaryAccentBrush}" />
                            <TextBlock Text="ACCESS &amp; MEMORY DEFENSES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Key Zeroization" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="CryptographicOperations.ZeroMemory" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Workstation Lock Listener" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="Active (Auto-lock on Win + L)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Inactivity Auto-Lock" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="Configured (15 Minutes)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Password Storage" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="Zero Plaintext Storage (Ephemeral)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Process Telemetry" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="Disabled (100% Local-Only)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: RECOVERY READINESS -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SecurityCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="DISASTER RECOVERY READINESS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Recovery Key Architecture" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="Zero-Knowledge Master KEK" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Backup Format" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text=".pvbackup (Authenticated)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Manifest Integrity Verification" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="SHA-256 Catalog Hash Verification" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Last Successful Backup" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="LastBackupStatusText" Text="None Recorded" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: INTEGRITY AUDIT -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SecurityCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="DATA INTEGRITY VERIFICATION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>

                        <TextBlock Text="Executes a deep cryptographic audit across all stored file chunks on disk to verify zero bit-rot, corruption, or tampering." 
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />

                        <TextBlock x:Name="LastIntegrityCheckText" Text="Status: Ready for audit." FontWeight="Medium" Foreground="{StaticResource SuccessBrush}" FontSize="12" />

                        <Button Content="Execute Full Cryptographic Verification" Style="{StaticResource PrimaryButtonStyle}" Click="VerifyButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SECTION 5: SECURITY RECOMMENDATIONS -->
            <Border Style="{StaticResource SecurityCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="RECOMMENDATIONS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Border Background="{StaticResource SecondaryBackgroundBrush}" Padding="12" CornerRadius="6">
                            <TextBlock Text="• Regular Offline Backups: Export a .pvbackup package after storing critical documents and keep it on detached media." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                        <Border Background="{StaticResource SecondaryBackgroundBrush}" Padding="12" CornerRadius="6">
                            <TextBlock Text="• Maintain Unique Master Passwords: Use passwords with at least 14 characters to maximize Argon2id hardness against offline brute-force attacks." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                        <Border Background="{StaticResource SecondaryBackgroundBrush}" Padding="12" CornerRadius="6">
                            <TextBlock Text="• Lock Workstation When Away: Windows key + L automatically triggers immediate volatile memory key zeroization in PHANTOMVAULT." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 6: EMERGENCY IMMEDIATE LOCKDOWN -->
            <Border BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" Background="{StaticResource SecondaryBackgroundBrush}" CornerRadius="8" Padding="18">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{StaticResource ErrorBrush}" />
                        <TextBlock Text="EMERGENCY ACTION: IMMEDIATE LOCKDOWN" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" FontSize="13" />
                    </StackPanel>
                    
                    <TextBlock Text="Immediately zeroize and destroy all active encryption keys from volatile memory and close all open vaults across the entire application." 
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />

                    <Button Content="TRIGGER EMERGENCY LOCK ALL" Style="{StaticResource DestructiveButtonStyle}" Click="EmergencyLockButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
