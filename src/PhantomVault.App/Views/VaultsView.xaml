<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhantomVault_App.Views.VaultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PhantomVault.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="1180" HorizontalAlignment="Left">

            <!-- HEADER & ACTIONS -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="My Vaults" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Independently protected local cryptographic storage enclaves. Each vault has an isolated Master Key and KEK." 
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" />
                    <Button Content="Create New Vault" Style="{StaticResource PrimaryButtonStyle}" Click="CreateVaultButton_Click" />
                </StackPanel>
            </Grid>

            <!-- VAULTS LIST -->
            <ItemsControl x:Name="VaultsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:VaultDescriptor">
                        <Border Style="{StaticResource SecurityCardStyle}" Margin="0,0,0,14">
                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- TOP ROW: NAME, STATUS BADGE, SPEC -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ICON & NAME -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Width="40" Height="40">
                                            <FontIcon Glyph="&#xE72E;" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock Text="{x:Bind VaultPath}" FontSize="11" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- STATE BADGE -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="AES-256-GCM • Argon2id" FontSize="11" FontFamily="{StaticResource MonospaceFontFamily}" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </Border>

                                        <Border CornerRadius="4" Padding="10,4" Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                                            <TextBlock Text="{x:Bind State}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- BOTTOM ROW: STATS & ACTIONS -->
                                <Grid Grid.Row="1" Background="{StaticResource SecondaryBackgroundBrush}" Padding="14,10" CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="STORED FILES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{x:Bind FileCount}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ENCRYPTED ON DISK" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{x:Bind TotalCiphertextBytes}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CREATED DATE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{x:Bind CreatedAtUtc}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>

                                    <!-- ACTION BUTTONS -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Unlock" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" Click="UnlockVaultCard_Click" Tag="{x:Bind}" />
                                        <Button Content="Open Files" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="OpenWorkspaceCard_Click" Tag="{x:Bind}" />
                                        <Button Content="Backup" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="BackupVaultCard_Click" Tag="{x:Bind}" />
                                        <Button Content="Verify" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="VerifyVaultCard_Click" Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- EMPTY STATE IF NO VAULTS -->
            <Border x:Name="EmptyVaultsBorder" Style="{StaticResource SecurityCardStyle}" Padding="40" HorizontalAlignment="Center" MaxWidth="520" Visibility="Collapsed">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="48" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No Local Vaults Found" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Create your first encrypted vault to begin storing files with authenticated AES-256-GCM encryption." 
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" />
                    <Button Content="Create Your First Vault" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Padding="20,10" Click="CreateVaultButton_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
