<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhantomVault_App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="820" HorizontalAlignment="Left">

            <!-- HEADER -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings &amp; Product Transparency" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Configure local application preferences, review privacy guarantees, and inspect cryptographic standards." 
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
            </StackPanel>

            <!-- SECTION 1: GENERAL PREFERENCES -->
            <Border Style="{StaticResource SecurityCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" />
                        <TextBlock Text="GENERAL PREFERENCES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Interface Theme" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Optimized high-contrast cybersecurity dark theme" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <ComboBox HorizontalAlignment="Right" Width="140" SelectedIndex="0">
                            <ComboBoxItem Content="Dark (Default)" />
                        </ComboBox>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Default Vault Storage Root" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DefaultVaultDirBox" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse Folder..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowseDefaultDir_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION: TACTICAL CYBER SOUND EFFECTS -->
            <Border Style="{StaticResource SecurityCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" />
                        <TextBlock Text="TACTICAL CYBER SOUND EFFECTS &amp; ACOUSTIC FEEDBACK" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <TextBlock Text="Pure mathematical in-memory synthesized PCM audio feedback. Provides responsive acoustic confirmation for unlocking, locking, shredding, and emergency alarms." 
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />

                    <ToggleSwitch x:Name="SoundEffectsToggleSwitch" Header="Enable Tactical Cyber Audio Feedback" IsOn="True" Toggled="SoundEffectsToggleSwitch_Toggled" />

                    <!-- AUDITION BUTTONS -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Audition Synthesized Waveforms" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="🔊 Unlock Chime" Style="{StaticResource SecondaryButtonStyle}" Click="TestUnlockSound_Click" />
                            <Button Content="🔒 Lock Arming" Style="{StaticResource SecondaryButtonStyle}" Click="TestLockSound_Click" />
                            <Button Content="☣️ DoD Shred" Style="{StaticResource SecondaryButtonStyle}" Click="TestShredSound_Click" />
                            <Button Content="📡 Stego Chirp" Style="{StaticResource SecondaryButtonStyle}" Click="TestStegoSound_Click" />
                            <Button Content="🚨 Lockdown Alarm" Style="{StaticResource DestructiveButtonStyle}" Click="TestEmergencySound_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 2: PRIVACY & ZERO TELEMETRY -->
            <Border Style="{StaticResource SecurityCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="PRIVACY &amp; LOCAL-ONLY GUARANTEE" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <Border Background="{StaticResource SecondaryBackgroundBrush}" Padding="14" CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Zero Telemetry &amp; Offline Integrity Declaration" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="• PHANTOMVAULT contains zero network telemetry, analytics, or background reporting services." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="• No mandatory online account or cloud registration exists. The software operates 100% offline." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="• Plaintext file contents, encryption keys, and passwords are never written to logs or transmitted across any socket." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION 3: BACKUP REMINDERS -->
            <Border Style="{StaticResource SecurityCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="BACKUP REMINDERS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <ToggleSwitch Header="Notify When No Backup Archive Has Been Created" IsOn="True" />
                    <ToggleSwitch Header="Require Master Password Verification Before Backup Restoration" IsOn="True" />
                </StackPanel>
            </Border>

            <!-- SECTION 4: PRODUCT IDENTITY & CRYPTOGRAPHIC SPECIFICATIONS -->
            <Border Style="{StaticResource SecurityCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource PrimaryAccentBrush}" />
                        <TextBlock Text="ABOUT PHANTOMVAULT" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="PHANTOMVAULT v1.0.0 LTS" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Trust Nothing. Reveal Nothing." FontStyle="Italic" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="12" />
                    </StackPanel>

                    <Grid RowSpacing="6" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Architecture:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Native Windows Desktop (WinUI 3 / Windows App SDK / .NET 8 LTS)" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Symmetric Cipher:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="AES-256-GCM (NIST SP 800-38D, 128-bit authentication tag, unique nonces)" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Key Derivation:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Argon2id (RFC 9106, 64 MB RAM, 4 Iterations, 4 Lanes)" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Steganography:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="PNG 24bpp RGB scanline LSB + 16-bit PCM WAV audio sample LSB" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />
                    </Grid>

                    <!-- KNOWN SECURITY LIMITATIONS DISCLOSURE -->
                    <Border Background="{StaticResource SecondaryBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Known Technical Limitations &amp; Residual Risks" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="Managed-memory cleanup cannot guarantee removal of every secret copy from physical RAM, swap, crash dumps, or operating-system internals. Furthermore, malware running under the user's active session can intercept inputs or read process memory. Physical possession and forensic analysis may identify filesystem metadata traces." 
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
