<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhantomVault_App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Application Settings &amp; Policies" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Configure automated lock timeouts, emergency safeguards, and local security policies." 
                       Foreground="{StaticResource SubtleHeaderBrush}" FontSize="13" />
        </StackPanel>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                <!-- INACTIVITY POLICIES -->
                <Border Style="{StaticResource SecurityCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="AUTOMATIC LOCK POLICIES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandPurpleBrush}" />

                        <ToggleSwitch x:Name="AutoLockToggle" Header="Lock Vaults on Inactivity" IsOn="True" Toggled="PolicyChanged" />

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="TimeoutLabel" Text="Inactivity Timeout: 15 minutes" FontSize="13" />
                            <Slider x:Name="TimeoutSlider" Minimum="1" Maximum="60" Value="15" StepFrequency="1" ValueChanged="TimeoutSlider_ValueChanged" />
                        </StackPanel>

                        <ToggleSwitch x:Name="SessionLockToggle" Header="Lock Instantly on Windows Workstation Lock (Win + L)" IsOn="True" Toggled="PolicyChanged" />
                    </StackPanel>
                </Border>

                <!-- DEAD-MAN'S SWITCH -->
                <Border Style="{StaticResource SecurityCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="DEAD-MAN'S SWITCH SAFEGUARD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandDangerBrush}" />
                        <TextBlock Text="If enabled, an audio/visual countdown will trigger after extended inactivity, locking all vaults unless dismissed." 
                                   Foreground="{StaticResource SubtleHeaderBrush}" FontSize="13" TextWrapping="Wrap" />

                        <ToggleSwitch x:Name="DeadMansToggle" Header="Enable Dead-Man's Switch" IsOn="False" Toggled="PolicyChanged" />
                    </StackPanel>
                </Border>

                <!-- PRODUCT IDENTITY & TRANSPARENCY -->
                <Border Style="{StaticResource SecurityCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="PHANTOMVAULT v1.0.0 LTS" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="Official Tagline: Trust Nothing. Reveal Nothing." FontStyle="Italic" Foreground="{StaticResource BrandCyanBrush}" FontSize="13" />
                        
                        <TextBlock Text="Architecture: Native Windows Desktop (WinUI 3 / Windows App SDK / .NET 8 LTS)." 
                                   Foreground="{StaticResource SubtleHeaderBrush}" FontSize="12" Margin="0,4,0,0" />
                        <TextBlock Text="Storage: 100% Local-first offline storage. Zero telemetric data collection, zero network connectivity requirements." 
                                   Foreground="{StaticResource SubtleHeaderBrush}" FontSize="12" />
                        <TextBlock Text="Cryptography: AES-256-GCM, Argon2id, PBKDF2-HMAC-SHA256, BCrypt CSPRNG." 
                                   Foreground="{StaticResource SubtleHeaderBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
