<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PhantomVault_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhantomVault_App"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- MINIMALIST OBSIDIAN DESIGN TOKENS -->
            <!-- Backgrounds and Surfaces -->
            <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#08090C" />
            <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#0E1117" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0B0D13" />
            <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#131722" />
            <SolidColorBrush x:Key="ElevatedSurfaceHoverBrush" Color="#1A202F" />
            <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#131722" />
            
            <!-- Muted Pastel Accents -->
            <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#4ED9C8" />
            <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#64E5D6" />
            <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#A5B4FC" />
            <SolidColorBrush x:Key="SecondaryAccentHoverBrush" Color="#C7D2FE" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
            <SolidColorBrush x:Key="ErrorHoverBrush" Color="#FCA5A5" />
            
            <!-- Typography Hierarchy (High Legibility Minimalist) -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
            
            <!-- Subtle Hairline Borders (Crisp 1px Precision) -->
            <SolidColorBrush x:Key="BorderBrush" Color="#1E2433" />
            <SolidColorBrush x:Key="BorderHoverBrush" Color="#333E56" />
            <SolidColorBrush x:Key="BorderAccentBrush" Color="#4ED9C8" />

            <!-- Typography Families -->
            <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="MonospaceFontFamily">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

            <!-- REUSABLE COMPONENT STYLES -->
            <!-- Security Card / Elevated Surface Style -->
            <Style x:Key="SecurityCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- Flat Card Style for inner groupings -->
            <Style x:Key="SubCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <!-- Primary Action Button (Pastel Mint, Obsidian Text, Smooth Hover) -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                <Setter Property="Foreground" Value="#08090C" />
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource PrimaryAccentHoverBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource PrimaryAccentHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource PrimaryAccentBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary Action Button (Obsidian Surface, Mint Hairline Glow on Hover) -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource ElevatedSurfaceHoverBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource SecondaryBackgroundBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource BorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quick Action Card Button (Dashboard Tile Button with Border Glow) -->
            <Style x:Key="QuickActionCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,14" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource ElevatedSurfaceHoverBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource SecondaryBackgroundBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource BorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pastel Indigo Accent Button -->
            <Style x:Key="IndigoButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SecondaryAccentBrush}" />
                <Setter Property="Foreground" Value="#08090C" />
                <Setter Property="BorderBrush" Value="{StaticResource SecondaryAccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource SecondaryAccentHoverBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource SecondaryAccentHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource SecondaryAccentBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource SecondaryAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Destructive Action Button (Pastel Rose) -->
            <Style x:Key="DestructiveButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                <Setter Property="Foreground" Value="#08090C" />
                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource ErrorHoverBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource ErrorHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{StaticResource ErrorBrush}" />
                                                <Setter Target="RootBorder.BorderBrush" Value="{StaticResource ErrorBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Backward compatibility aliases -->
            <StaticResource x:Key="BrandPurpleBrush" ResourceKey="SecondaryAccentBrush" />
            <StaticResource x:Key="BrandCyanBrush" ResourceKey="PrimaryAccentBrush" />
            <StaticResource x:Key="BrandDangerBrush" ResourceKey="ErrorBrush" />
            <StaticResource x:Key="BrandSuccessBrush" ResourceKey="SuccessBrush" />
            <StaticResource x:Key="BrandWarningBrush" ResourceKey="WarningBrush" />
            <StaticResource x:Key="CardBackgroundBrush" ResourceKey="ElevatedSurfaceBrush" />
            <StaticResource x:Key="CardBorderBrush" ResourceKey="BorderBrush" />
            <StaticResource x:Key="SubtleHeaderBrush" ResourceKey="SecondaryTextBrush" />
            <StaticResource x:Key="AccentButtonStyle" ResourceKey="PrimaryButtonStyle" />
            <StaticResource x:Key="DangerButtonStyle" ResourceKey="DestructiveButtonStyle" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
