<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PhantomVault_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhantomVault_App"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- PHANTOMVAULT OFFICIAL DESIGN TOKENS -->
            <!-- Backgrounds and Surfaces -->
            <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#0B0D12" />
            <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#11151D" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0E1118" />
            <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#171C26" />
            
            <!-- Accents -->
            <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#39D0C8" />
            <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#7C83FF" />
            
            <!-- Typography Colors -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F5F9" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A1A9B8" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#697386" />
            
            <!-- Functional Status Colors -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#36C98F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F2B84B" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F06A75" />
            
            <!-- Borders and Dividers -->
            <SolidColorBrush x:Key="BorderBrush" Color="#252C38" />

            <!-- Typography Families -->
            <FontFamily x:Key="DefaultFontFamily">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="MonospaceFontFamily">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

            <!-- REUSABLE COMPONENT STYLES -->
            <!-- Security Card / Elevated Surface Style -->
            <Style x:Key="SecurityCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <!-- Flat Card Style for inner groupings -->
            <Style x:Key="SubCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SecondaryBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <!-- Primary Action Button (Teal Accent, Dark Text) -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}" />
                <Setter Property="Foreground" Value="#0B0D12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Secondary Action Button (Elevated Surface, Subtle Border) -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <!-- Indigo Accent Button -->
            <Style x:Key="IndigoButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SecondaryAccentBrush}" />
                <Setter Property="Foreground" Value="#0B0D12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Destructive Action Button (Error Red) -->
            <Style x:Key="DestructiveButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                <Setter Property="Foreground" Value="#0B0D12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Backward compatibility aliases -->
            <StaticResource x:Key="BrandPurpleBrush" ResourceKey="SecondaryAccentBrush" />
            <StaticResource x:Key="BrandCyanBrush" ResourceKey="PrimaryAccentBrush" />
            <StaticResource x:Key="BrandDangerBrush" ResourceKey="ErrorBrush" />
            <StaticResource x:Key="BrandSuccessBrush" ResourceKey="SuccessBrush" />
            <StaticResource x:Key="BrandWarningBrush" ResourceKey="WarningBrush" />
            <StaticResource x:Key="CardBackgroundBrush" ResourceKey="ElevatedSurfaceBrush" />
            <StaticResource x:Key="CardBorderBrush" ResourceKey="BorderBrush" />
            <StaticResource x:Key="SubtleHeaderBrush" ResourceKey="SecondaryTextBrush" />
            <StaticResource x:Key="AccentButtonStyle" ResourceKey="PrimaryButtonStyle" />
            <StaticResource x:Key="DangerButtonStyle" ResourceKey="DestructiveButtonStyle" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
